# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never expose to the browser or commit to source control.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Booking JWT ─────────────────────────────────────────────────────────────
# A strong random secret used to sign and verify parent booking tokens.
# Server-side only. Never expose to the browser or commit to source control.
# Generate with: openssl rand -base64 32
BOOKING_JWT_SECRET=

# ─── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
# Arbitrary secret you define when registering the webhook in Meta Developer Console.
WHATSAPP_VERIFY_TOKEN=

# Meta App Secret — used to verify X-Hub-Signature-256 on incoming webhook POST requests.
# Found in: Meta Developer Console → App → Settings → Basic → App Secret
# Server-side only. Never expose to the browser or commit to source control.
WHATSAPP_APP_SECRET=

# ─── WhatsApp Embedded Signup (Sprint 7) ─────────────────────────────────────
# Meta App ID and Secret for the OAuth code exchange during Embedded Signup.
# Found in: Meta Developer Console → App → Settings → Basic
# Both are server-side only.
META_APP_ID=
META_APP_SECRET=

# Meta Embedded Signup Configuration ID — passed as config_id to FB.login (Sprint 31).
# Found in: Meta App Dashboard → WhatsApp → Embedded Signup → Configurations
NEXT_PUBLIC_META_CONFIG_ID=

# Two-step verification PIN for registering a connected number on WhatsApp Cloud
# API (POST /{phone_number_id}/register). Exactly 6 digits.
# Platform-level, not per-org: orgs never see it, and re-registering a number
# later requires the same value back. Server-side only.
WHATSAPP_REGISTER_PIN=

# 32-byte hex key for AES-256-GCM encryption of per-org WhatsApp access tokens.
# Server-side only. Never expose to the browser or commit to source control.
# Generate with: openssl rand -hex 32
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# ─── Meta App Review demo (scripts/connect-demo-whatsapp.ts) ─────────────
# Temporary (~23h) access token for Meta's WhatsApp TEST NUMBER, copied from
# App Dashboard → WhatsApp → API Setup. Re-run the connect script after refresh.
# WHATSAPP_TOKEN_ENCRYPTION_KEY above must match the production (Vercel) value.
WHATSAPP_DEMO_ACCESS_TOKEN=
WHATSAPP_DEMO_PHONE_NUMBER_ID=1338080832713619
WHATSAPP_DEMO_WABA_ID=1066332709132512
DEMO_ORG_OWNER_EMAIL=hadart20@gmail.com

# Demo feature flags (set =1 in Vercel for the App Review period only):
# DEMO_RESCHEDULE_ENABLED — WhatsApp bot reschedule intent ("להזיז את השיעור ל-18:00")
# DEMO_PAYMENT_LINK_ENABLED — payment request without a configured payment provider
DEMO_RESCHEDULE_ENABLED=
DEMO_PAYMENT_LINK_ENABLED=

# ─── Payment Provider (Sprint 8) ─────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of per-org payment provider credentials.
# Server-side only. Never expose to the browser or commit to source control.
# Generate with: openssl rand -hex 32
PAYMENT_CONFIG_ENCRYPTION_KEY=

# Bit Business / PayBox webhooks — optional HMAC (SHA-256, Base64) over raw POST body.
# When unset, webhooks are accepted without signature verification (dev only).
# Set per provider dashboard when configuring the webhook URL.
BIT_WEBHOOK_HMAC_SECRET=
PAYBOX_WEBHOOK_HMAC_SECRET=

# ─── Portal JWT (Sprint 13) ──────────────────────────────────────────────────
# A strong random secret used to sign parent portal session cookies (30-day httpOnly JWT).
# Server-side only. Never expose to the browser or commit to source control.
# Minimum 32 characters. Generate with: openssl rand -base64 32
PORTAL_JWT_SECRET=

# ─── Support Session (Sprint 18) ──────────────────────────────────────────────
# A strong random secret used to sign support-mode session cookies.
# Server-side only. Never expose to the browser or commit to source control.
# Minimum 32 characters. Generate with: openssl rand -base64 32
SUPPORT_SESSION_SECRET=

# ─── AI Assistant (Sprint 19) ────────────────────────────────────────────────
# OpenAI API key for the AI WhatsApp assistant (gpt-4o-mini).
# Platform-level — not per org. Required for every production deploy because
# env validation fails fast before the app starts serving traffic.
# In non-production, the AI settings page keeps the feature disabled until this
# value is configured, so local/staging environments fail safely instead of
# enabling a broken toggle.
# Server-side only. Never expose to the browser or commit to source control.
# Found in: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── AI Provider Encryption (Sprint 25) ────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of per-org AI provider API keys.
# Server-side only. Never expose to the browser or commit to source control.
# Generate with: openssl rand -hex 32
AI_CONFIG_ENCRYPTION_KEY=

# ─── Email (Sprint 25 — Resend) ─────────────────────────────────────────────
# API key for Resend email delivery (lesson/payment reminders, receipts, grading).
# Server-side only. Never expose to the browser or commit to source control.
# Found in: https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender email address — must be verified in the Resend dashboard.
# Example: noreply@yourdomain.com
RESEND_FROM_EMAIL=

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL of this application (used to build booking links sent via WhatsApp).
# Example: https://your-domain.com  or  http://localhost:3000  for local dev.
NEXT_PUBLIC_APP_URL=

# ─── SaaS billing (Sumit checkout + webhook) ─────────────────────────────────
# Same credentials as Sumit receipts (settings) unless you use a separate Sumit account.
SUMIT_COMPANY_ID=
SUMIT_API_KEY=
# Optional: override the Sumit hosted-checkout endpoint (default: https://api.sumit.co.il/billing/payments/beginredirect/).
SUMIT_CHECKOUT_ENDPOINT=
# Local/test: skip real Sumit; after choosing a paid plan, open in-app /onboarding/mock-payment (or /account/billing/mock-payment) then complete simulated checkout.
SUMIT_CHECKOUT_MOCK=
# Onboarding paid plan buttons: omit or any value = placeholder only; set to sumit to use Sumit/mock checkout (requires SUMIT_* or SUMIT_CHECKOUT_MOCK=1). Production must set this to: sumit
NEXT_PUBLIC_ONBOARDING_PAID_CHECKOUT=
# VAT on the plan prices. Omit (default true) while the company is a VAT-exempt
# dealer (עוסק פטור): the price in saas_plans is the whole amount charged, and
# Sumit adds nothing. Set to false after registering for VAT, so Sumit adds VAT
# on top — and update pricing.vatNote in src/lib/marketing/landingCopy.ts to match.
SAAS_PRICES_INCLUDE_VAT=
# Optional HMAC SHA-256 (hex) of the raw body; header x-sumit-signature as sha256=<hex>. Activation is gated by a server-to-server confirmation, so an unsigned trigger is allowed through (it still can't activate without Sumit confirming); a signed trigger with a bad signature is rejected.
SUMIT_WEBHOOK_SECRET=

# ─── Error Monitoring (Sentry) ────────────────────────────────────────────────
# Sentry DSN — enables error monitoring in production. Client-side (NEXT_PUBLIC_).
# Found in: Sentry project → Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Auth token for uploading source maps during build. Server-side only.
# Found in: Sentry → Settings → Auth Tokens
SENTRY_AUTH_TOKEN=

# ─── Public landing (/) ──────────────────────────────────────────────────────
# Optional: URL for the “Book a demo” CTA (e.g. Calendly). If unset, demo links to /signup.
NEXT_PUBLIC_BOOK_DEMO_URL=

# Optional: shown in the landing footer and legal pages when set (plain text; not a secret).
# These must be set in production for Meta Business Verification compliance.
NEXT_PUBLIC_BUSINESS_ADDRESS=נוקדים כפר אלדד 142, ישראל
NEXT_PUBLIC_SUPPORT_EMAIL=cs@hadarturgemanautomations.com
NEXT_PUBLIC_BUSINESS_PHONE=050-434-3547
NEXT_PUBLIC_BUSINESS_REG=204174361
